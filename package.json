{
  "name": "agent-notch",
  "version": "0.31.0",
  "private": true,
  "description": "Agent Notch - a voice and screen assistant for Windows",
  "author": "Shravan Kumar",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "build:native": "node scripts/build-native.cjs",
    "make:icon": "electron scripts/rasterize-icon.cjs",
    "prepack": "npm run build:ui && node scripts/prepare-package.cjs",
    "pack": "electron-builder --dir",
    "predist": "npm run build:ui && node scripts/prepare-package.cjs",
    "dist": "electron-builder --win nsis",
    "build:ui": "node scripts/build-eleven-ui.cjs",
    "prestart": "npm run build:ui"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-popover": "1.3.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-scroll-area": "1.4.0",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slider": "1.6.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@tailwindcss/cli": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "electron": "44.10.2",
    "electron-builder": "^26.0.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.70.0",
    "motion": "14.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "use-stick-to-bottom": "1.1.6"
  },
  "build": {
    "appId": "app.agentnotch.desktop",
    "productName": "Agent Notch",
    "artifactName": "Agent-Notch-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "shravan-kumar-nalacharla",
        "repo": "agent-notch-releases",
        "releaseType": "release"
      }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": [
          "**/*",
          "!**/*.pdb"
        ]
      },
      {
        "from": "tools/agent-browsers",
        "to": "agent-browsers",
        "filter": [
          "chromium-*/**/*",
          "ffmpeg-*/**/*"
        ]
      }
    ],
    "win": {
      "icon": "src/assets/icon.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agent Notch",
      "uninstallDisplayName": "Agent Notch",
      "deleteAppDataOnUninstall": false,
      "include": "installer/consent.nsh"
    },
    "electronLanguages": [
      "en-US",
      "en-GB",
      "hi",
      "te"
    ]
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.8.11",
    "ical.js": "2.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "1.64.1",
    "unzipper": "^0.12.5"
  }
}
